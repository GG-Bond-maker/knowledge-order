# ═══════════════════════════════════════════════
#  知序学院 · 环境变量模板
#
#  复制为 .env.local 后按需修改：
#    copy .env.example .env.local
#
#  注意：前端能读取的变量必须以 VITE_ 开头。
# ═══════════════════════════════════════════════

# ── 后端内容服务 ──
# 监听端口（默认 3001）
PORT=3001
# 监听地址（仅本机；改成 0.0.0.0 可局域网访问，注意安全）
HOST=127.0.0.1

# ── 前端 ──
# 开发服务器端口（默认 5173；本项目开发脚本用 5175）
VITE_DEV_PORT=5173
# API 基础路径（默认 /api，由 Vite 代理到后端）
VITE_API_BASE=/api

# ── 内容数据 ──
# 课程内容 JSON 存放目录（默认 <项目>/content-data）
# CONTENT_DIR=D:\Python_Project\knowledge-order\content-data
