# ═══════════════════════════════════════════════
#  知序学院 · pnpm 配置
#
#  本项目使用 pnpm 作为包管理器，依赖安装在项目内的
#  node_modules/（而非全局共享），相当于 JS 世界的「虚拟环境」。
# ═══════════════════════════════════════════════

# 国内镜像，加速安装
registry=https://registry.npmmirror.com

# 依赖以符号链接方式装进项目内 node_modules（pnpm 默认，显式声明避免被全局配置覆盖）
node-linker=isolated

# 严格按 package.json 声明的版本安装，禁止意外提升（避免幽灵依赖）
shamefully-hoist=false
strict-peer-dependencies=false

# 减少控制台噪音
reporter=append-only
