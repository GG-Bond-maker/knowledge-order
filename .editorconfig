# ═══════════════════════════════════════════════
#  EditorConfig —— 跨编辑器统一基础格式
#  https://editorconfig.org
# ═══════════════════════════════════════════════

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown 保留行尾空格（用于换行）
[*.md]
trim_trailing_whitespace = false

# Python 文件（课程代码片段/脚本）
[*.py]
indent_size = 4

[*.{json,yaml,yml}]
indent_size = 2

# Windows 批处理
[*.{bat,cmd}]
end_of_line = crlf
