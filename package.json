{
  "name": "knowledge-order",
  "private": true,
  "version": "2.0.0",
  "description": "知序学院 —— 不局限于数据分析的多学科个人学习平台：数据分析 / 算法 / 大模型",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "runtime": "node scripts/copy-runtime.mjs",
    "predev": "node scripts/copy-runtime.mjs",
    "prebuild": "node scripts/copy-runtime.mjs",
    "server": "node server/index.mjs",
    "dev": "vite",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "tsc -b --noEmit && vite build",
    "start": "node server/index.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "audit": "node scripts/content-audit.mjs",
    "difficulty": "node scripts/difficulty-report.mjs",
    "sync": "node scripts/sync-content.mjs",
    "verify:sql": "node scripts/verify-judging.mjs",
    "verify:course": "node scripts/verify-course-browser.mjs",
    "test:api": "node scripts/test-api.mjs",
    "test:nav": "node scripts/e2e-nav-group.mjs",
    "test:brand": "node scripts/e2e-brand.mjs",
    "test:migrate": "node scripts/e2e-migrate.mjs",
    "test:platform": "node scripts/e2e-platform.mjs",
    "format": "prettier --write \"{src,server,scripts}/**/*.{ts,tsx,css,mjs,json}\" \"*.{json,md,html}\"",
    "format:check": "prettier --check \"{src,server,scripts}/**/*.{ts,tsx,css,mjs,json}\" \"*.{json,md,html}\""
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.9.0",
    "@codemirror/language": "^6.11.0",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.1",
    "@uiw/react-codemirror": "^4.23.13",
    "antd": "^5.27.4",
    "cors": "^2.8.6",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.2",
    "express": "^5.3.0",
    "katex": "^0.19.0",
    "pyodide": "0.29.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0",
    "sql.js": "^1.15.1"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.12",
    "playwright-core": "^1.49.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
