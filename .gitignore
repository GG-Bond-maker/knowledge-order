# 依赖
node_modules/
.venv/
.venv*/
venv/
ENV/

# 构建产物
dist/
dist-ssr/
*.tsbuildinfo

# 临时目录与缓存
.tmp-*/
.esbuild-tmp/
qa/
.cache*/
.pycache*/
__pycache__/
*.py[cod]
*$py.class
pip-*
torchinductor_*

# 日志
*.log
npm-debug.log*
pnpm-debug.log*

# 环境变量（保留模板）
.env
.env.local
.env.*.local
!.env.example

# 编辑器
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store

# 包管理器迁移备份
package-lock.json.bak

# 注意：public/pyodide/ 与 public/sqljs/ 是离线运行必需的运行时资源，
# 体积约 32MB。若用 git 管理，建议保留（可直接部署）；
# 若仓库体积敏感，可改为构建时由 `pnpm run runtime` 生成并加入 .gitignore。

# 课程内容数据（content-data/）建议纳入版本控制以便备份，不要忽略。
